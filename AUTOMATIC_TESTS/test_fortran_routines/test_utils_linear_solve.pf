module test_utils_linear_solve
  use funit
  use linear_solve
  use plasma_interface, only: stella_plasma_init, stella_plasma_finish
  implicit none

  integer, parameter :: n = 12

contains

  ! PLASMA has to be initialised for the PLASMA_DENSE code, without PLASMA these do nothing
  @before
  subroutine set_up
    call stella_plasma_init
  end subroutine set_up

  @after
  subroutine tear_down
    call stella_plasma_finish
  end subroutine tear_down

  ! A complex matrix that needs pivoting (small diagonal)
  function test_matrix() result(a)
    complex, dimension(n, n) :: a
    integer :: i, j
    do j = 1, n
      do i = 1, n
        a(i, j) = cmplx(sin(real(3 * i + 7 * j)), cos(real(5 * i - 2 * j)))
      end do
      a(j, j) = 1.0e-3 * a(j, j)
    end do
  end function test_matrix

  ! A real matrix that needs pivoting (small diagonal)
  function test_matrix_real() result(a)
    real, dimension(n, n) :: a
    integer :: i, j
    do j = 1, n
      do i = 1, n
        a(i, j) = sin(real(3 * i + 7 * j)) + cos(real(5 * i - 2 * j))
      end do
      a(j, j) = 1.0e-3 * a(j, j)
    end do
  end function test_matrix_real

  ! Factorise A and solve A x = b, the residual |A x - b| should be at round-off level
  @test
  subroutine test_lu_complex_residual
    complex, dimension(n, n) :: a, lu
    complex, dimension(n) :: b, x
    integer, dimension(n) :: idx
    real :: d
    integer :: i

    a = test_matrix()
    b = [(cmplx(real(i), -0.5 * real(i)), i=1, n)]
    lu = a
    x = b
    call lu_decomposition(lu, idx, d)
    call lu_back_substitution(lu, idx, x)
    @assertLessThan(maxval(abs(matmul(a, x) - b)), 1.0e-10 * maxval(abs(b)))
    @assertTrue(abs(d) == 1.0)
  end subroutine test_lu_complex_residual

  ! Solve for several right-hand sides at once with the same factors
  @test
  subroutine test_lu_complex_matrix_residual
    complex, dimension(n, n) :: a, lu
    complex, dimension(n, n) :: b, x
    integer, dimension(n) :: idx
    real :: d
    integer :: i, k

    a = test_matrix()
    do k = 1, n
      b(:, k) = [(cmplx(real(i * k), 1.0 / real(i + k)), i=1, n)]
    end do
    lu = a
    x = b
    call lu_decomposition(lu, idx, d)
    call lu_back_substitution(lu, idx, x)
    @assertLessThan(maxval(abs(matmul(a, x) - b)), 1.0e-10 * maxval(abs(b)))
  end subroutine test_lu_complex_matrix_residual

  ! Several right-hand sides, fewer than size(lu, 1), and in a b with more rows than A. The
  ! first nonzero of the second column comes before the one of the first column
  @test
  subroutine test_lu_complex_matrix_nonsquare
    complex, dimension(n, n) :: a, lu
    complex, dimension(n + 2, 3) :: b, x
    integer, dimension(n) :: idx
    real :: d
    integer :: i

    a = test_matrix()
    b = 0.0
    b(5:n, 1) = [(cmplx(real(i), 1.0), i=5, n)]
    b(1:n, 2) = [(cmplx(1.0, real(i)), i=1, n)]
    b(1:n, 3) = [(cmplx(cos(real(i)), 0.0), i=1, n)]
    b(n + 1:, :) = cmplx(7.0, 7.0)
    lu = a
    x = b
    call lu_decomposition(lu, idx, d)
    call lu_back_substitution(lu, idx, x)
    @assertLessThan(maxval(abs(matmul(a, x(1:n, :)) - b(1:n, :))), 1.0e-10 * maxval(abs(b(1:n, :))))
    @assertTrue(all(x(n + 1:, :) == b(n + 1:, :)))
  end subroutine test_lu_complex_matrix_nonsquare

  ! A A^-1 should be the identity at round-off level
  @test
  subroutine test_lu_complex_inverse
    complex, dimension(n, n) :: a, lu, inv, id
    integer, dimension(n) :: idx
    real :: d
    integer :: i

    a = test_matrix()
    lu = a
    call lu_decomposition(lu, idx, d)
    call lu_inverse(lu, idx, inv)
    id = 0.0
    do i = 1, n
      id(i, i) = 1.0
    end do
    @assertLessThan(maxval(abs(matmul(a, inv) - id)), 1.0e-10)
    @assertLessThan(maxval(abs(matmul(inv, a) - id)), 1.0e-10)
  end subroutine test_lu_complex_inverse

  ! The determinant d * prod(diag(U)) does not depend on the pivoting, so it also checks the sign d
  @test
  subroutine test_lu_complex_determinant
    complex, dimension(3, 3) :: lu
    integer, dimension(3) :: idx
    real :: d
    complex :: det
    integer :: j

    ! The rows (0,1,2), (1,0,3), (4,-3,8) give det = 0 - 1*(8-12) + 2*(-3) = -2, and the zero
    ! in the first column needs pivoting
    lu = transpose(reshape([cmplx(0.0), cmplx(1.0), cmplx(2.0), &
                            cmplx(1.0), cmplx(0.0), cmplx(3.0), &
                            cmplx(4.0), cmplx(-3.0), cmplx(8.0)], [3, 3]))
    call lu_decomposition(lu, idx, d)
    det = d
    do j = 1, 3
      det = det * lu(j, j)
    end do
    @assertLessThan(abs(det - cmplx(-2.0)), 1.0e-12)
  end subroutine test_lu_complex_determinant

  ! Solve with the same factors from several OpenMP threads at once, as stella does inside its
  ! !$omp loops. Without OpenMP this is a plain loop
  @test
  subroutine test_lu_complex_solve_in_omp_loop
    integer, parameter :: nb = 32
    complex, dimension(n, n) :: a, lu
    complex, dimension(n, nb) :: b, x
    integer, dimension(n) :: idx
    real :: d
    integer :: i, k

    a = test_matrix()
    do k = 1, nb
      b(:, k) = [(cmplx(real(i + k), sin(real(i * k))), i=1, n)]
    end do
    lu = a
    x = b
    call lu_decomposition(lu, idx, d)
    !$omp parallel do
    do k = 1, nb
      call lu_back_substitution(lu, idx, x(:, k))
    end do
    !$omp end parallel do
    @assertLessThan(maxval(abs(matmul(a, x) - b)), 1.0e-10 * maxval(abs(b)))
  end subroutine test_lu_complex_solve_in_omp_loop

  ! A singular matrix must not give NaNs or Infs (zero pivots are replaced by a small number)
  @test
  subroutine test_lu_complex_singular
    complex, dimension(2, 2) :: lu
    integer, dimension(2) :: idx
    real :: d

    lu = reshape([cmplx(1.0), cmplx(2.0), cmplx(2.0), cmplx(4.0)], [2, 2])
    call lu_decomposition(lu, idx, d)
    @assertTrue(all(abs(lu) < huge(1.0)))
    @assertTrue(abs(d) == 1.0)
    @assertTrue(abs(lu(2, 2)) > 0.0)
  end subroutine test_lu_complex_singular

  ! The factors of a singular matrix come from the stella routine also with PLASMA, and the
  ! solve with them must not give NaNs either
  @test
  subroutine test_lu_complex_singular_solve
    complex, dimension(2, 2) :: lu
    complex, dimension(2) :: x
    integer, dimension(2) :: idx
    real :: d

    lu = reshape([cmplx(1.0), cmplx(2.0), cmplx(2.0), cmplx(4.0)], [2, 2])
    x = [cmplx(1.0), cmplx(2.0)]
    call lu_decomposition(lu, idx, d)
    call lu_back_substitution(lu, idx, x)
    @assertFalse(any(x /= x))
  end subroutine test_lu_complex_singular_solve

  ! Real version of test_lu_complex_residual
  @test
  subroutine test_lu_real_residual
    real, dimension(n, n) :: a, lu
    real, dimension(n) :: b, x
    integer, dimension(n) :: idx
    real :: d
    integer :: i

    a = test_matrix_real()
    b = [(real(i) - 0.3 * real(i * i), i=1, n)]
    lu = a
    x = b
    call lu_decomposition(lu, idx, d)
    call lu_back_substitution(lu, idx, x)
    @assertLessThan(maxval(abs(matmul(a, x) - b)), 1.0e-10 * maxval(abs(b)))
    @assertTrue(abs(d) == 1.0)
  end subroutine test_lu_real_residual

  ! Real version of test_lu_complex_solve_in_omp_loop
  @test
  subroutine test_lu_real_solve_in_omp_loop
    integer, parameter :: nb = 32
    real, dimension(n, n) :: a, lu
    real, dimension(n, nb) :: b, x
    integer, dimension(n) :: idx
    real :: d
    integer :: i, k

    a = test_matrix_real()
    do k = 1, nb
      b(:, k) = [(real(i + k) * sin(real(i * k)), i=1, n)]
    end do
    lu = a
    x = b
    call lu_decomposition(lu, idx, d)
    !$omp parallel do
    do k = 1, nb
      call lu_back_substitution(lu, idx, x(:, k))
    end do
    !$omp end parallel do
    @assertLessThan(maxval(abs(matmul(a, x) - b)), 1.0e-10 * maxval(abs(b)))
  end subroutine test_lu_real_solve_in_omp_loop

  ! Real version of test_lu_complex_determinant
  @test
  subroutine test_lu_real_determinant
    real, dimension(3, 3) :: lu
    integer, dimension(3) :: idx
    real :: d, det
    integer :: j

    lu = transpose(reshape([0.0, 1.0, 2.0, &
                            1.0, 0.0, 3.0, &
                            4.0, -3.0, 8.0], [3, 3]))
    call lu_decomposition(lu, idx, d)
    det = d
    do j = 1, 3
      det = det * lu(j, j)
    end do
    @assertLessThan(abs(det + 2.0), 1.0e-12)
  end subroutine test_lu_real_determinant

  ! Real version of test_lu_complex_singular
  @test
  subroutine test_lu_real_singular
    real, dimension(2, 2) :: lu
    integer, dimension(2) :: idx
    real :: d

    lu = reshape([1.0, 2.0, 2.0, 4.0], [2, 2])
    call lu_decomposition(lu, idx, d)
    @assertTrue(all(abs(lu) < huge(1.0)))
    @assertTrue(abs(d) == 1.0)
    @assertTrue(abs(lu(2, 2)) > 0.0)
  end subroutine test_lu_real_singular

end module test_utils_linear_solve
