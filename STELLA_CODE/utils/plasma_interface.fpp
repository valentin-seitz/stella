!###############################################################################
!                         Interface to the PLASMA library
!###############################################################################
! PLASMA (Parallel Linear Algebra Software for Multicore Architectures) is used
! for the LU operations of stella when it is compiled with PLASMA (USE_PLASMA=on
! with Make, -DSTELLA_ENABLE_PLASMA=ON with CMake, both on by default), which
! defines the PLASMA preprocessor flag.
!
! PLASMA's README mentions a Fortran interface, but its module (plasma_mod.f90)
! is only generated by the old Makefile build of PLASMA, with
! plasma/tools/fortran_gen.py, and that script fails on the current headers. The
! CMake build of PLASMA, which stella uses, does not create it. Hence the few C
! routines that stella needs are bound here through iso_c_binding. The
! signatures follow
!     plasma/include/plasma_context.h
!     plasma/include/plasma_z.h, plasma_d.h
!
! When stella is compiled with PLASMA, the dense (utils/linear_solve) and band
! (utils/banded_lu) LU routines always use it, except inside OpenMP parallel
! regions: PLASMA's routines use a shared context and open their own OpenMP
! parallel region, so there the LU routines call LAPACK instead. See
! <plasma_usable>.
!
! The routines <stella_linear_algebra_init> and <stella_linear_algebra_finish>
! always exist, so that they can be called from files that are not
! preprocessed. Without the PLASMA flag they do nothing.
!###############################################################################
module plasma_interface

#ifdef PLASMA
   use, intrinsic :: iso_c_binding, only: c_int, c_double, c_double_complex
#endif

   implicit none

   private

   public :: stella_linear_algebra_init
   public :: stella_linear_algebra_finish
   public :: plasma_usable

   ! Whether <stella_linear_algebra_init> has initialised PLASMA, the PLASMA
   ! routines that use the PLASMA context can only be called after it
   logical :: plasma_initialised = .false.

#ifdef PLASMA

   ! The values of plasma_enum_t that stella needs. PLASMA defines them in
   ! anonymous C enums (plasma/include/plasma_types.h), not as preprocessor
   ! macros, so they can't be included in Fortran. The enums below mirror those
   ! of plasma_types.h, so that the values follow from the same rules as in C.
   ! The transpose options are those of CBLAS (CblasNoTrans = 111).
   enum, bind(c)
      enumerator :: PlasmaNoTrans = 111
   end enum
   enum, bind(c)
      enumerator :: PlasmaDisabled = 0, PlasmaEnabled = 1
   end enum
   enum, bind(c)
      ! The parameters of plasma_set and plasma_get, in the order of plasma_types.h
      enumerator :: PlasmaTuning, PlasmaNb
   end enum

   public :: PlasmaNoTrans, PlasmaNb
   public :: plasma_set, plasma_get
   public :: plasma_zgetrf, plasma_zgetrs, plasma_zgetri
   public :: plasma_dgetrf, plasma_dgetrs, plasma_dgetri
   public :: plasma_zgbtrf

   interface

      !-------------------------------------------------------------------------
      !                           Context (plasma_context.h)
      !-------------------------------------------------------------------------
      integer(c_int) function plasma_init() bind(c, name='plasma_init')
         import :: c_int
      end function plasma_init

      integer(c_int) function plasma_finalize() bind(c, name='plasma_finalize')
         import :: c_int
      end function plasma_finalize

      integer(c_int) function plasma_set(param, val) bind(c, name='plasma_set')
         import :: c_int
         integer(c_int), value :: param, val
      end function plasma_set

      integer(c_int) function plasma_get(param, val) bind(c, name='plasma_get')
         import :: c_int
         integer(c_int), value :: param
         integer(c_int), intent(out) :: val
      end function plasma_get

      !-------------------------------------------------------------------------
      !                     Dense LU, complex (plasma_z.h)
      !-------------------------------------------------------------------------
      integer(c_int) function plasma_zgetrf(m, n, pA, lda, ipiv) bind(c, name='plasma_zgetrf')
         import :: c_int, c_double_complex
         integer(c_int), value :: m, n, lda
         complex(c_double_complex), dimension(*) :: pA
         integer(c_int), dimension(*) :: ipiv
      end function plasma_zgetrf

      integer(c_int) function plasma_zgetrs(trans, n, nrhs, pA, lda, ipiv, pB, ldb) bind(c, name='plasma_zgetrs')
         import :: c_int, c_double_complex
         integer(c_int), value :: trans, n, nrhs, lda, ldb
         complex(c_double_complex), dimension(*) :: pA, pB
         integer(c_int), dimension(*) :: ipiv
      end function plasma_zgetrs

      integer(c_int) function plasma_zgetri(n, pA, lda, ipiv) bind(c, name='plasma_zgetri')
         import :: c_int, c_double_complex
         integer(c_int), value :: n, lda
         complex(c_double_complex), dimension(*) :: pA
         integer(c_int), dimension(*) :: ipiv
      end function plasma_zgetri

      !-------------------------------------------------------------------------
      !                       Dense LU, real (plasma_d.h)
      !-------------------------------------------------------------------------
      integer(c_int) function plasma_dgetrf(m, n, pA, lda, ipiv) bind(c, name='plasma_dgetrf')
         import :: c_int, c_double
         integer(c_int), value :: m, n, lda
         real(c_double), dimension(*) :: pA
         integer(c_int), dimension(*) :: ipiv
      end function plasma_dgetrf

      integer(c_int) function plasma_dgetrs(trans, n, nrhs, pA, lda, ipiv, pB, ldb) bind(c, name='plasma_dgetrs')
         import :: c_int, c_double
         integer(c_int), value :: trans, n, nrhs, lda, ldb
         real(c_double), dimension(*) :: pA, pB
         integer(c_int), dimension(*) :: ipiv
      end function plasma_dgetrs

      integer(c_int) function plasma_dgetri(n, pA, lda, ipiv) bind(c, name='plasma_dgetri')
         import :: c_int, c_double
         integer(c_int), value :: n, lda
         real(c_double), dimension(*) :: pA
         integer(c_int), dimension(*) :: ipiv
      end function plasma_dgetri

      !-------------------------------------------------------------------------
      !                     Banded LU, complex (plasma_z.h)
      !-------------------------------------------------------------------------
      integer(c_int) function plasma_zgbtrf(m, n, kl, ku, pAB, ldab, ipiv) bind(c, name='plasma_zgbtrf')
         import :: c_int, c_double_complex
         integer(c_int), value :: m, n, kl, ku, ldab
         complex(c_double_complex), dimension(*) :: pAB
         integer(c_int), dimension(*) :: ipiv
      end function plasma_zgbtrf

   end interface

#endif

contains

   !****************************************************************************
   !                    Initialise the linear algebra libraries
   !****************************************************************************
   ! PLASMA has to be initialised once per MPI process, outside of any OpenMP
   ! parallel region. Its internal tuning is switched off, so that the shared
   ! PLASMA context is never modified while stella calls PLASMA.
   !****************************************************************************
   subroutine stella_linear_algebra_init

#ifdef PLASMA
      use mp, only: mp_abort
#endif

      implicit none

#ifdef PLASMA
      integer(c_int) :: info

      !-------------------------------------------------------------------------

      if (plasma_initialised) return
      info = plasma_init()
      if (info /= 0) call mp_abort('stella_linear_algebra_init: plasma_init failed')
      info = plasma_set(PlasmaTuning, PlasmaDisabled)
      if (info /= 0) call mp_abort('stella_linear_algebra_init: disabling PLASMA tuning failed')
      plasma_initialised = .true.
#endif

   end subroutine stella_linear_algebra_init

   !****************************************************************************
   !                     Finalise the linear algebra libraries
   !****************************************************************************
   subroutine stella_linear_algebra_finish

      implicit none

#ifdef PLASMA
      integer(c_int) :: info

      !-------------------------------------------------------------------------

      if (.not. plasma_initialised) return
      info = plasma_finalize()
      plasma_initialised = .false.
#endif

   end subroutine stella_linear_algebra_finish

   !****************************************************************************
   ! Whether the LU routines should call PLASMA here: stella is compiled with
   ! PLASMA, PLASMA is initialised, and we are not inside an OpenMP parallel
   ! region.
   !****************************************************************************
   logical function plasma_usable()

#ifdef USE_OPENMP
      use omp_lib, only: omp_in_parallel
#endif

      implicit none

#ifdef PLASMA
      plasma_usable = plasma_initialised
#ifdef USE_OPENMP
      if (omp_in_parallel()) plasma_usable = .false.
#endif
#else
      plasma_usable = .false.
#endif

   end function plasma_usable

end module plasma_interface
